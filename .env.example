# Paste your real key after the '=' to enable Claude scoring.
# Left empty, the app still runs end to end but grades with the offline heuristic.
ANTHROPIC_API_KEY=

# Optional: restrict who can log in (comma separated). Empty = any valid email.
ALLOWED_EMAIL_DOMAINS=

# Optional: interview duration in minutes (default 30)
INTERVIEW_MINUTES=30

# Optional: model used for scoring
SCORING_MODEL=claude-opus-5
